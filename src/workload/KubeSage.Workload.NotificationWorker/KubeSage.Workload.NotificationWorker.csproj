<!--
  Background processor that can appear healthy to Kubernetes while doing no useful work.

  Shared behaviour (log format, correlation, faults, metrics, health probes)
  comes from KubeSage.Workload.Shared so every service in the demo produces
  the same shape of telemetry.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KubeSage.Workload.Shared\KubeSage.Workload.Shared.csproj" />
  </ItemGroup>

</Project>
