{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Http": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",

  "KubeSage": {
    "Database": {
      "ConnectionString": "Host=localhost;Port=5433;Database=kubesage;Username=kubesage_app;Password=kubesage_app_local_dev",
      "MigrationConnectionString": "Host=localhost;Port=5433;Database=kubesage;Username=kubesage_owner;Password=kubesage_local_dev",
      "MaxPoolSize": 20,
      "CommandTimeoutSeconds": 30,
      "RunMigrationsOnStartup": true
    },

    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "ChatModel": "gemma4:12b",
      "EmbeddingModel": "embeddinggemma:300m",
      "ContextTokens": 8192,
      "RequestTimeoutSeconds": 900,
      "Temperature": 0.1,
      "EmbeddingDimensions": 768,
      "StartupProbeTimeoutSeconds": 30
    },

    "Telemetry": {
      "LokiEndpoint": "http://localhost:3100",
      "PrometheusEndpoint": "http://localhost:9090",
      "QueryTimeoutSeconds": 30,
      "MaxLogLinesPerQuery": 500,
      "MaxQueryRangeMinutes": 120,
      "WorkloadNamespace": "kubesage-demo"
    },

    "Kubernetes": {
      "KubeConfigPath": null,
      "AllowedNamespaces": [ "kubesage-demo", "kubesage-observability" ],
      "RequestTimeoutSeconds": 30,
      "MaxItemsPerQuery": 200
    },

    "Detection": {
      "Enabled": true,
      "EvaluationWindowMinutes": 5,
      "EvaluationIntervalSeconds": 60,
      "DeduplicationCooldownMinutes": 15,
      "RecoveryConfirmationMinutes": 10,
      "Thresholds": {
        "HttpErrorRate": 0.10,
        "MinimumRequestSample": 20,
        "LatencyP95Seconds": 1.5,
        "PodRestartIncrease": 2,
        "UnreadyPodCount": 1,
        "RepeatedErrorSignatureCount": 10,
        "DependencyFailureCount": 5
      }
    },

    "Analysis": {
      "StartupWarmupSeconds": 120,
      "RunStartupAnalysis": true,
      "ScheduledIntervalSeconds": 300,
      "RunScheduledAnalysis": true
    },

    "Investigation": {
      "MaxConcurrent": 1,
      "TimeoutSeconds": 1800,
      "MaxToolCalls": 20,
      "MaxEvidenceItems": 60,
      "MaxRetries": 3,
      "RetryBaseDelaySeconds": 30,
      "DispatcherPollSeconds": 5,
      "WorkLeaseSeconds": 2400
    },

    "Retrieval": {
      "Enabled": true,
      "TopK": 5,
      "MaxDistance": 0.65,
      "IndexRunbooksOnStartup": true
    }
  }
}
