# Single source of truth for every pinned external version in KubeSage.
#
# Both Docker Compose (via --env-file) and the Python automation read this
# file, so a version is written down exactly once. .NET package versions live
# separately in Directory.Packages.props because NuGet needs them there.
#
# Everything is pinned to an exact version on purpose. Floating tags such as
# "latest" would let an unrelated upstream release silently change how the
# platform behaves between two bootstraps of the same commit.

# --- External operations plane (Docker Compose) ---
OLLAMA_IMAGE=ollama/ollama:0.32.13
POSTGRES_IMAGE=pgvector/pgvector:pg18-trixie
GRAFANA_IMAGE=grafana/grafana:13.1.3

# --- In-cluster observability (Kubernetes manifests) ---
LOKI_IMAGE=grafana/loki:3.7.6
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
FLUENTBIT_IMAGE=fluent/fluent-bit:4.2.8

# --- Kind cluster ---
# This is the exact node image that kind v0.32.0 ships as its default. Using
# the shipped default avoids subtle mismatches between the kind binary and the
# Kubernetes version inside the node containers.
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
KIND_CLUSTER_NAME=kubesage

# --- Local models served by Ollama ---
# gemma4:12b is the reasoning model used by all three agents.
# embeddinggemma:300m produces the vectors stored in pgvector.
KUBESAGE_CHAT_MODEL=gemma4:12b
KUBESAGE_EMBEDDING_MODEL=embeddinggemma:300m

# --- Host ports published by the operations plane ---
OLLAMA_HOST_PORT=11434
POSTGRES_HOST_PORT=5433
GRAFANA_HOST_PORT=3000
PLATFORM_HOST_PORT=8081

# --- Host ports published by the Kind cluster (see deploy/kind/cluster.yaml) ---
# These are the ONLY way the operations plane reaches services inside the
# cluster. Kind node IP addresses are never used directly.
KIND_API_HOST_PORT=6443
LOKI_HOST_PORT=3100
PROMETHEUS_HOST_PORT=9090
GATEWAY_HOST_PORT=8080
